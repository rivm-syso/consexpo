             DECOMC decomc = new DECOMC(decc, decbc, dechc, LINAL);
             SLVRAD slvrad = new SLVRAD(sol, solc, solb, solbc, solh, solhc, LINAL);
             ESTRAD estrad = new ESTRAD(sol, solb, solh, LINAL);
-            RADCOR radcor = new RADCOR(decomr, decomc, slvrad, estrad, CONRA5, LINAL);
+            RADCOR radcor = new RADCOR(decomr, decomc, slvrad, estrad, CONRA5, LINAL, false);
             #endregion
             #region Set Dependencies
             
@@ -1061,10 +1061,12 @@ namespace DotNumerics.ODE.Radau5
         #region Common Block: LINAL Declaration
         
         CommonBlock _linal;
-        Oint MLE; Oint MUE; Oint MBJAC; Oint MBB; Oint MDIAG; Oint MDIFF; Oint MBDIAG; 
+        private readonly bool _applyStepSizeFix;
+        Oint MLE; Oint MUE; Oint MBJAC; Oint MBB; Oint MDIAG; Oint MDIFF; Oint MBDIAG;
         #endregion
         #endregion
-        public RADCOR(DECOMR decomr, DECOMC decomc, SLVRAD slvrad, ESTRAD estrad, CommonBlock CONRA5, CommonBlock LINAL)
+        public RADCOR(DECOMR decomr, DECOMC decomc, SLVRAD slvrad, ESTRAD estrad, CommonBlock CONRA5, CommonBlock LINAL,
+            bool applyStepSizeFix)
         {
     
             #region Set Dependencies
@@ -1088,6 +1090,7 @@ namespace DotNumerics.ODE.Radau5
             #region Common Block: LINAL Initialization
             
             this._linal = LINAL;
+            _applyStepSizeFix = applyStepSizeFix;
             MLE = LINAL.intData[0];
             MUE = LINAL.intData[1];
             MBJAC = LINAL.intData[2];
@@ -1647,7 +1650,12 @@ namespace DotNumerics.ODE.Radau5
                 HOPT = Math.Min(H, HNEW);
                 if (REJECT) HNEW = POSNEG * Math.Min(Math.Abs(HNEW), Math.Abs(H));
                 REJECT = false;
-                if ((X + HNEW / QUOT1 - XEND) * POSNEG >= 0.0E0)
+
+                // Workaround: Small reduction of the integration end time, to prevent small rounding errors requiring a tiny final step, which results in and 'STEP SIZE STEP SIZE BECOMES TOO SMALL'-error. Only used when needed.
+                // This fix might need to be re-applied, when a new version of this library will be used.
+                var finalStepTolerance = _applyStepSizeFix ? -1E-8 * XEND : 0.0E0;
+
+                if ((X + HNEW / QUOT1 - XEND) * POSNEG >= finalStepTolerance)
                 {
                     H = XEND - X;
                     LAST = true;
